{
  "name": "rakhshan-chat",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "turbo run db:generate --filter=@rakhshan/backend",
    "db:migrate": "turbo run db:migrate --filter=@rakhshan/backend",
    "db:push": "turbo run db:push --filter=@rakhshan/backend",
    "mobile:start": "turbo run start --filter=@rakhshan/mobile",
    "mobile:android": "turbo run android --filter=@rakhshan/mobile",
    "mobile:ios": "turbo run ios --filter=@rakhshan/mobile",
    "backend:start": "turbo run start:dev --filter=@rakhshan/backend"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "prettier": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "packageManager": "npm@10.8.0"
}
