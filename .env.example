# ─── Application ───
NODE_ENV=development
APP_NAME=RakhshanChat
APP_VERSION=1.0.0

# ─── Backend ───
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
WS_URL=ws://localhost:3000

# ─── Database ───
DATABASE_URL=postgresql://rakhshan:rakhshan_secret@localhost:5432/rakhshan_chat?schema=public
REDIS_URL=redis://localhost:6379

# ─── Authentication ───
JWT_SECRET=your-jwt-secret-min-32-chars-long-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Encryption ───
ENCRYPTION_MASTER_KEY=your-256-bit-hex-master-key-here

# ─── Storage ───
S3_BUCKET=rakhshan-chat-media
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_ENDPOINT=http://localhost:9000

# ─── Push Notifications ───
FCM_SERVER_KEY=your-firebase-cloud-messaging-key
APNS_KEY_ID=your-apple-push-notification-key-id
APNS_TEAM_ID=your-apple-team-id

# ─── Rate Limiting ───
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ─── TURN/STUN (WebRTC Calls) ───
TURN_SERVER_URL=turn:turn.example.com:3478
TURN_USERNAME=turnuser
TURN_PASSWORD=turnpassword
STUN_SERVER_URL=stun:stun.l.google.com:19302

# ─── SMS/OTP Provider ───
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Logging ───
LOG_LEVEL=debug
